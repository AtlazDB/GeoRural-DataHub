# Copie para .env ao lado do docker-compose.yaml. O .env NAO vai para o git.
# Valores com espaco ou parenteses vao entre aspas simples.

# Branch de cada repositorio que vai para o ar.
BACK_BRANCH=dev
FRONT_BRANCH=dev

# Porta local do front. Nao e aberta para fora: o Caddy publica em HTTPS.
APP_PORT=8081

# Enderecos publicos (HTTPS, sem barra no fim). Sem dominio proprio, use o sslip.io:
#   https://georural.<IP-com-tracos>.sslip.io  e  https://auth.<IP-com-tracos>.sslip.io
SITE_URL=https://georural.EXEMPLO
AUTH_URL=https://auth.EXEMPLO

# ---------------------------------------------------------------- Banco (Autonomous Database)
# Console da OCI > Autonomous Database > o banco > "Database connection" > TLS > servico _tp > Copy.
# Na frente vai jdbc:oracle:thin:@ . Exige a lista de acesso com o IP desta VM e o mTLS desligado.
SPRING_DATASOURCE_URL='jdbc:oracle:thin:@(description= (retry_count=20)(retry_delay=3)(address=(protocol=tcps)(port=1522)(host=adb.sa-saopaulo-1.oraclecloud.com))(connect_data=(service_name=xxxx_georural_tp.adb.oraclecloud.com))(security=(ssl_server_dn_match=yes)))'
# Dono das tabelas (o Flyway cria tudo nele). Senha sem @ / : " (quebram o JDBC) nem $.
DB_USERNAME=GEO_RURAL
DB_PASSWORD=

# ---------------------------------------------------------------- Object Storage (zona bruta)
OCI_NAMESPACE=
OCI_BUCKET=
OCI_ZONA_BRUTA=bruta
# Pasta com config + chave da OCI na VM. Se ficar vazio, o deploy.sh usa $HOME/.oci.
OCI_CONFIG_DIR=

# ---------------------------------------------------------------- Airflow
# Pela rede "georural" (o padrao ja e este). Senha do admin: no servidor, em
#   ~/georural-repo/infra/airflow/config/simple_auth_manager_passwords.json.generated
AIRFLOW_URL=http://airflow-apiserver:8080
AIRFLOW_USUARIO=admin
AIRFLOW_SENHA=

# Coleta automática das fontes por link (periodicidade ou cron da fonte). Padrão: ligada.
# A primeira coleta de cada fonte é sempre pelo botão Executar. "false" desliga.
# COLETA_AUTOMATICA_HABILITADA=true

# ---------------------------------------------------------------- Keycloak
# Admin do console (https://auth...). So vale na primeira subida, com o banco do Keycloak vazio.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=
# Senha do Postgres do Keycloak (so os containers usam). Gere com:  openssl rand -hex 16
KEYCLOAK_DB_PASSWORD=
# Credencial tecnica do back no Keycloak. Gere com:  openssl rand -hex 24
# So vale na primeira subida (vai para o realm na importacao).
KEYCLOAK_BACKEND_SECRET=
